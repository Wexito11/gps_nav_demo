<?xml version="1.0"?>
<sdf version="1.9" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ===== Obstacle macros: one line per obstacle ===== -->
  <xacro:macro name="box_obs" params="name x y sx sy sz yaw:=0 r:=0.55 g:=0.55 b:=0.6">
    <model name="${name}">
      <static>true</static>
      <pose>${x} ${y} ${sz/2} 0 0 ${yaw}</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>${sx} ${sy} ${sz}</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>${sx} ${sy} ${sz}</size></box></geometry>
          <material><ambient>${r} ${g} ${b} 1</ambient><diffuse>${r} ${g} ${b} 1</diffuse></material>
        </visual>
      </link>
    </model>
  </xacro:macro>

  <xacro:macro name="cyl_obs" params="name x y rad h">
    <model name="${name}">
      <static>true</static>
      <pose>${x} ${y} ${h/2} 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><cylinder><radius>${rad}</radius><length>${h}</length></cylinder></geometry></collision>
        <visual name="vis">
          <geometry><cylinder><radius>${rad}</radius><length>${h}</length></cylinder></geometry>
          <material><ambient>0.35 0.45 0.6 1</ambient><diffuse>0.35 0.45 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>
  </xacro:macro>

  <!-- Visual-only zone marker (no collision: the robot drives over it) -->
  <xacro:macro name="zone" params="name x y r g b">
    <model name="${name}">
      <static>true</static>
      <pose>${x} ${y} 0.003 0 0 0</pose>
      <link name="link">
        <visual name="vis">
          <geometry><box><size>1.4 1.4 0.005</size></box></geometry>
          <material><ambient>${r} ${g} ${b} 1</ambient><diffuse>${r} ${g} ${b} 1</diffuse></material>
        </visual>
      </link>
    </model>
  </xacro:macro>

  <world name="nav_world">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat"/>

    <!-- GPS origin: BMSTU main building, Moscow (world x = East, y = North) -->
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <latitude_deg>55.7659</latitude_deg>
      <longitude_deg>37.6850</longitude_deg>
      <elevation>150</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.75 0.85 0.95 1</background>
      <shadows>false</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="col">
          <geometry><plane><normal>0 0 1</normal><size>30 20</size></plane></geometry>
        </collision>
        <visual name="vis">
          <geometry><plane><normal>0 0 1</normal><size>30 20</size></plane></geometry>
          <material><ambient>0.5 0.55 0.5 1</ambient><diffuse>0.5 0.55 0.5 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Start A (green) and finish B (red) -->
    <xacro:zone name="zone_A" x="-8.0" y="0.0" r="0.1" g="0.8" b="0.2"/>
    <xacro:zone name="zone_B" x="8.5"  y="0.0" r="0.9" g="0.1" b="0.1"/>

    <!-- Obstacles on the straight line A -> B -->
    <xacro:box_obs name="wall_1"   x="-4.5" y="0.6"  sx="0.6" sy="2.4" sz="0.8"/>
    <xacro:cyl_obs name="pillar_1" x="-2.0" y="-1.2" rad="0.35" h="1.0"/>
    <xacro:box_obs name="crate_1"  x="0.0"  y="0.8"  sx="1.0" sy="1.0" sz="0.8" yaw="0.4"/>
    <xacro:box_obs name="wall_2"   x="1.5"  y="-1.5" sx="0.4" sy="2.0" sz="0.8"/>
    <!-- Low curb (8 cm): BELOW the lidar plane (20 cm), only the depth camera can see it -->
    <xacro:box_obs name="curb"     x="4.0"  y="0.0"  sx="0.25" sy="1.8" sz="0.08" r="0.95" g="0.75" b="0.1"/>
    <xacro:cyl_obs name="pillar_2" x="6.0"  y="1.0"  rad="0.3" h="1.0"/>
    <xacro:box_obs name="crate_2"  x="6.2"  y="-1.3" sx="0.8" sy="0.8" sz="0.8"/>
  </world>
</sdf>
